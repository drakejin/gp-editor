<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the local QA copy only (scripts/qa/run.sh re-signs a copy of the Release app with these):
     no App Sandbox, so the QA driver can read its script and fixtures and write snapshots. Never ship this. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
