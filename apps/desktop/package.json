{
  "name": "gp-editor-desktop",
  "version": "0.20.0",
  "license": "LGPL-2.1-or-later",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "build:macos": "scripts/soundfont/fetch.sh && scripts/audio-codecs/fetch.sh && xcodebuild -workspace macos/GPEditor.xcworkspace -scheme GPEditor-macOS -configuration Release -derivedDataPath macos/build/DerivedData -destination platform=macOS build",
    "pods": "pod install --project-directory=macos",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "package:macos": "scripts/release/package.sh",
    "soundfont": "scripts/soundfont/fetch.sh",
    "audio-codecs": "scripts/audio-codecs/fetch.sh",
    "soundfont:win": "node scripts/soundfont/fetch.mjs",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "tauri": "tauri",
    "tauri:dev": "npm run soundfont:win && tauri dev",
    "build:windows": "npm run soundfont:win && tauri build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "^0.83.0",
    "react-native-web": "^0.21.2",
    "spessasynth_lib": "4.3.14",
    "@gp-editor/core": "file:../../packages/gp-core"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-native-web": "^0.19.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "codegenConfig": {
    "name": "GPEditorSpec",
    "type": "components",
    "jsSrcsDir": "src/native/specs",
    "ios": {
      "componentProvider": {
        "GPScoreCanvas": "GPScoreCanvasComponentView"
      }
    }
  }
}
