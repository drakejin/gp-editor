{
  "name": "gp-editor-desktop",
  "version": "0.8.0",
  "license": "LGPL-2.1-or-later",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "build:macos": "scripts/soundfont/fetch.sh && xcodebuild -workspace macos/GPEditor.xcworkspace -scheme GPEditor-macOS -configuration Release -derivedDataPath macos/build/DerivedData -destination platform=macOS build",
    "pods": "pod install --project-directory=macos",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "package:macos": "scripts/release/package.sh",
    "soundfont": "scripts/soundfont/fetch.sh"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "^0.83.0",
    "@gp-editor/core": "file:../../packages/gp-core"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "codegenConfig": {
    "name": "GPEditorSpec",
    "type": "components",
    "jsSrcsDir": "src/native/specs",
    "ios": {
      "componentProvider": {
        "GPScoreCanvas": "GPScoreCanvasComponentView"
      }
    }
  }
}
