{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    // Type `react-native` imports against the macOS fork, which adds the desktop props
    // (keyDownEvents, draggedTypes, onDrop …) this app uses.
    "paths": {
      "react-native": ["./node_modules/react-native-macos"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // The Windows build's sources are checked by tsconfig.web.json (DOM, Vite, react-native-web).
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "macos/build",
    "ios",
    "android",
    "web",
    "web-dist",
    "src/**/*.web.ts",
    "src/**/*.web.tsx",
    "src/native/web",
    "src-tauri",
    "vite.config.ts"
  ]
}
